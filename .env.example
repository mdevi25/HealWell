# HealWell Environment Variables
# Copy this file to .env.local and fill in your values

# Make.com webhook URL for AI shift story generation
NEXT_PUBLIC_MAKE_WEBHOOK_URL=https://hook.us2.make.com/your_webhook_here

# Admin password for /admin dashboard
ADMIN_PASSWORD=your_admin_password_here

# Neon database connection string (added in STEP-09)
DATABASE_URL=postgresql://user:password@host/database